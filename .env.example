# Client Secret of the Sentry Internal Integration
# Sentry > Settings > Custom Integrations > your integration > Credentials
SENTRY_CLIENT_SECRET=

# GitHub fine-grained PAT with "Issues: Read and write" on every target repo
GITHUB_TOKEN=

# Sentry project slug -> destination repo. A project that is not in the map is ignored.
REPO_MAP={"acme-api":"acme/backend","acme-web":"acme/frontend"}

# Optional: where to send projects that are not in REPO_MAP. Without it, they are ignored.
# DEFAULT_REPO=acme/catch-all

# Your Sentry organisation slug. Only used to build the issue link when the
# webhook payload does not carry a permalink.
SENTRY_ORG=acme

# Minimum level to report: debug | info | warning | error | fatal
MIN_LEVEL=error

# Labels applied to the created issue (comma separated). They must already exist
# in the target repo, otherwise GitHub answers 422.
ISSUE_LABELS=sentry,bug
